---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  pubDate?: Date;
  tags?: string[];
}

const { title, description = 'The science of table tennis and health. Peer-reviewed research on how table tennis extends life, protects the brain, and transforms aging.', ogImage, article = false, pubDate, tags = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f7" />

    <!-- Preload Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@300;400;500&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />

    <!-- SVG Favicon (table tennis paddle) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Pong News" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Pong News",
      "url": "https://pongnews.com",
      "description": description
    })} />
    <!-- FAQ Schema for AI Search Optimization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does table tennis really add years to your life?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A landmark study published in the Mayo Clinic Proceedings found that racket sports, including table tennis, add an average of 9.7 years to life expectancy. This is significantly more than gym activities (1.5 years) or cycling (3.4 years)."
          }
        },
        {
          "@type": "Question",
          "name": "Can table tennis prevent dementia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Research suggests table tennis is one of the most effective activities for brain health. Studies show it has a cognitive effect size of 2.05, far exceeding dancing (1.42) and walking (1.38). The WHO and Lancet Commission report that 40% of dementia cases are preventable through lifestyle changes, with racket sports ranking among the most protective activities."
          }
        },
        {
          "@type": "Question",
          "name": "How does table tennis compare to other sports for longevity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Copenhagen City Heart Study found racket sports add 9.7 years to life expectancy, compared to 6.2 years for cycling, 5.9 years for swimming, 3.4 years for jogging, and 1.5 years for gym workouts. Table tennis uniquely combines aerobic exercise, social interaction, and cognitive demands."
          }
        },
        {
          "@type": "Question",
          "name": "Is table tennis good for brain training?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A 2026 EEG study published in Frontiers in Psychology found that table tennis athletes show superior attentional control and working memory compared to non-athletes. The sport activates motor cortex, cerebellum, and executive function circuits simultaneously."
          }
        },
        {
          "@type": "Question",
          "name": "What is the injury rate in table tennis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Table tennis has the lowest injury rate among racket sports. A 2024 systematic review found an overall injury rate of just 3.6% in 873 professional players, compared to 36% in badminton. 64% of table tennis injuries caused no time loss from play."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I play table tennis for health benefits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Research indicates that playing table tennis 2-3 times per week for 45-60 minutes provides significant cardiovascular, cognitive, and longevity benefits. The social and mental demands of the sport amplify benefits beyond what solitary exercise can achieve."
          }
        },
        {
          "@type": "Question",
          "name": "Can seniors benefit from playing table tennis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. Table tennis is particularly beneficial for older adults because it improves balance, reaction time, and cognitive function while being low-impact. Studies show it helps prevent falls, maintains brain plasticity, and combats social isolation in seniors."
          }
        }
      ]
    })} />
  </head>
  <body>
    <!-- SVG Noise Grain Overlay -->
    <div class="grain"></div>

    <!-- Navigation -->
    <nav class="site-nav" aria-label="Main navigation">
      <div class="site-nav__inner">
        <a href="/" class="site-nav__logo">
          <img src="/images/logo.png" alt="Pong News" class="site-nav__logo-img" />
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Open menu">
          <span></span>
        </label>

        <ul class="site-nav__links">
          <li><a href="/articles">Articles</a></li>
          <li><a href="/category/Longevity">Longevity</a></li>
          <li><a href="/category/Cognitive%20Health">Brain</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
    </nav>

    <main class="site-main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer__inner">

        <div class="footer-columns">
          <div>
            <div class="footer-columns__brand-name">Pong News</div>
            <div>Where table tennis meets science.<br/>All claims backed by peer-reviewed research.</div>
          </div>
          <div class="footer-columns__links">
            <a href="/about">About</a>
            <a href="/articles">Articles</a>
            <a href="/sitemap-index.xml">Sitemap</a>
          </div>
        </div>

        <div class="footer-bottom">
          {currentYear} Pong News. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
