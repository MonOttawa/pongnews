---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Pong News" description="The page you're looking for doesn't exist on Pong News.">
  <div class="notfound">

    <p class="notfound__kicker">404</p>
    <h1 class="notfound__title">This page is off the table</h1>
    <p class="notfound__text">We couldn't find the article or page you're looking for. It may have moved, or the link may have a typo.</p>

    <div class="notfound__actions">
      <a href="/articles" class="notfound__btn notfound__btn--primary">Browse all articles</a>
      <a href="/" class="notfound__btn notfound__btn--secondary">Back to home</a>
    </div>

    <div class="notfound__categories">
      <p class="notfound__categories-label">Or explore by topic:</p>
      <ul class="notfound__categories-list">
        <li><a href="/category/Longevity">Longevity</a></li>
        <li><a href="/category/Cognitive%20Health">Cognitive Health</a></li>
        <li><a href="/category/Physical%20Health">Physical Health</a></li>
        <li><a href="/category/Mental%20Health">Mental Health</a></li>
        <li><a href="/category/Rehabilitation">Rehabilitation</a></li>
      </ul>
    </div>

  </div>
</Layout>

<style>
  .notfound {
    max-width: 640px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
    text-align: center;
  }

  .notfound__kicker {
    font-family: 'Fraunces', serif;
    font-variation-settings: "opsz" 144;
    font-weight: 300;
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 1;
    color: #c8553d;
    margin: 0 0 1rem;
  }

  .notfound__title {
    font-family: 'Fraunces', serif;
    font-variation-settings: "opsz" 48;
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    color: #1a1a1a;
  }

  .notfound__text {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #4a4a4a;
    margin: 0 0 2.5rem;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .notfound__btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.875rem 1.5rem;
    border-radius: 3px;
    text-decoration: none;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
                background-color 200ms ease,
                color 200ms ease;
  }

  .notfound__btn--primary {
    background-color: #1a1a1a;
    color: #faf9f7;
  }

  .notfound__btn--primary:hover {
    background-color: #c8553d;
    transform: translateY(-1px);
  }

  .notfound__btn--secondary {
    background-color: transparent;
    color: #1a1a1a;
    border: 1px solid #d4d0c8;
  }

  .notfound__btn--secondary:hover {
    background-color: #f5f3ef;
    transform: translateY(-1px);
  }

  .notfound__categories {
    border-top: 1px solid #e8e4dc;
    padding-top: 2rem;
  }

  .notfound__categories-label {
    font-size: 0.875rem;
    color: #6a6a6a;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .notfound__categories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .notfound__categories-list a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid #d4d0c8;
    border-radius: 3px;
    font-size: 0.9375rem;
    color: #1a1a1a;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .notfound__categories-list a:hover {
    border-color: #1a1a1a;
    background-color: #f5f3ef;
  }
</style>
