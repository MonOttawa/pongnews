---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Pong News" description="The page you're looking for doesn't exist on Pong News.">
  <div class="notfound">

    <p class="notfound__kicker">404</p>
    <h1 class="notfound__title">This page is off the table</h1>
    <p class="notfound__text">We couldn't find the article or page you're looking for. It may have moved, or the link may have a typo.</p>

    <div class="notfound__actions">
      <a href="/articles" class="notfound__btn notfound__btn--primary">Browse all articles</a>
      <a href="/" class="notfound__btn notfound__btn--secondary">Back to home</a>
    </div>

    <div class="notfound__categories">
      <p class="notfound__categories-label">Or explore by topic:</p>
      <ul class="notfound__categories-list">
        <li><a href="/category/Longevity">Longevity</a></li>
        <li><a href="/category/Cognitive%20Health">Cognitive Health</a></li>
        <li><a href="/category/Physical%20Health">Physical Health</a></li>
        <li><a href="/category/Mental%20Health">Mental Health</a></li>
        <li><a href="/category/Rehabilitation">Rehabilitation</a></li>
      </ul>
    </div>

  </div>
</Layout>

<style>
  .notfound {
    max-width: 640px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
    text-align: center;
  }

  .notfound__kicker {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 1;
    letter-spacing: -0.09375rem;
    color: #8F001A;
    margin: 0 0 1rem;
  }

  .notfound__title {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.0625rem;
    margin: 0 0 1.25rem;
    color: #2D2D2C;
  }

  .notfound__text {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 1.0625rem;
    line-height: 1.6875rem;
    letter-spacing: -0.03125rem;
    color: #2D2D2C;
    margin: 0 0 2.5rem;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .notfound__btn {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.125rem;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    border-radius: 44px 44px;
    text-decoration: none;
    transition: background-color 0.2s ease-out, box-shadow 0.2s ease-out;
  }

  .notfound__btn--primary {
    background-color: #8F001A;
    color: #FFFFFF;
  }

  .notfound__btn--primary:hover {
    background-color: #7B0016;
    box-shadow: 0 5px 10px 0 rgba(0, 0, 0, 0.2);
  }

  .notfound__btn--secondary {
    background-color: transparent;
    color: #2D2D2C;
    box-shadow: inset 0 0 0 2px #2D2D2C;
  }

  .notfound__btn--secondary:hover {
    background-color: #E2DEDE;
  }

  .notfound__categories {
    border-top: 1px solid #DFDFDF;
    padding-top: 2rem;
  }

  .notfound__categories-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2D2D2C;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.125rem;
  }

  .notfound__categories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .notfound__categories-list a {
    display: inline-block;
    padding: 10px 20px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    background-color: #F2F2F2;
    border-radius: 44px 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01375rem;
    color: #2D2D2C;
    text-decoration: none;
    transition: background-color 0.2s ease-out;
  }

  .notfound__categories-list a:hover {
    background-color: #D8D8D8;
  }
</style>
