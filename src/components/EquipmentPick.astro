---
// EquipmentPick: science-backed product recommendation cards.
// Zero JavaScript, matches the site design system (garnet accent,
// Work Sans + Spectral, 0.2s ease-out transitions).
//
// Usage:
//   <EquipmentPick ids={['killerspin-jet200', 'joola-training-balls']} />
//   <EquipmentPick ids={[...]} heading="Our picks for solo practice" />
//
// Links always point to Amazon. They carry the Associates tag (and the
// FTC disclosure renders) only after PUBLIC_AMAZON_TAG is configured --
// until then the cards are pure editorial content.
import { EQUIPMENT_BY_ID } from '../data/equipment';
import { amazonUrl, AMAZON_TAG_ACTIVE } from '../config/monetization';

interface Props {
  ids: string[];
  heading?: string;
}

const { ids, heading = 'Equipment picks' } = Astro.props as Props;
const items = ids.map((id) => EQUIPMENT_BY_ID[id]).filter(Boolean);
---

{items.length > 0 && (
  <section class="equipment-picks" aria-label={heading}>
    <h4 class="equipment-picks__heading">{heading}</h4>
    <div class="equipment-picks__grid">
      {items.map((item) => (
        <div class="equipment-card">
          <div class="equipment-card__top">
            <span class="equipment-card__category">{item.category}</span>
            <span class="equipment-card__price">{item.priceBand}</span>
          </div>
          <div class="equipment-card__name">{item.name}</div>
          <div class="equipment-card__bestfor">Best for: {item.bestFor}</div>
          <p class="equipment-card__why">{item.why}</p>
          {item.researchSlug && (
            <a href={`/article/${item.researchSlug}`} class="equipment-card__research">
              The research behind this pick &#8594;
            </a>
          )}
          <a
            href={amazonUrl(item.asin)}
            class="equipment-card__cta"
            target="_blank"
            rel={AMAZON_TAG_ACTIVE ? 'sponsored nofollow noopener' : 'noopener noreferrer'}
          >
            View on Amazon &#8599;
          </a>
        </div>
      ))}
    </div>
    {AMAZON_TAG_ACTIVE && (
      <p class="equipment-picks__disclosure">
        As an Amazon Associate, Pong News earns from qualifying purchases made through links on this page.
        Picks are editorial -- no brand paid for placement.
      </p>
    )}
  </section>
)}

<style is:global>
  .equipment-picks {
    margin: 2.5rem 0 1rem;
  }
  .equipment-picks__heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.15rem;
    margin: 0 0 1rem;
    color: var(--ink);
  }
  .equipment-picks__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .equipment-card {
    border: 1px solid rgba(45, 45, 44, 0.14);
    border-bottom: 3px solid var(--garnet);
    border-radius: 6px;
    padding: 1.1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    background: #fff;
    transition: box-shadow 0.2s ease-out;
  }
  .equipment-card:hover {
    box-shadow: 0 4px 18px rgba(45, 45, 44, 0.10);
  }
  .equipment-card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(45, 45, 44, 0.62);
    margin-bottom: 0.45rem;
  }
  .equipment-card__price {
    color: var(--garnet-dark);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .equipment-card__name {
    font-family: var(--serif);
    font-size: 1.02rem;
    line-height: 1.3;
    margin-bottom: 0.2rem;
  }
  .equipment-card__bestfor {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: rgba(45, 45, 44, 0.75);
    margin-bottom: 0.6rem;
  }
  .equipment-card__why {
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(45, 45, 44, 0.86);
    margin: 0 0 0.7rem;
    flex-grow: 1;
  }
  .equipment-card__research {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(143, 0, 26, 0.4);
    text-underline-offset: 3px;
    margin-bottom: 0.7rem;
  }
  .equipment-card__research:hover {
    color: var(--garnet-dark);
  }
  .equipment-card__cta {
    align-self: flex-start;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    background-color: var(--garnet);
    border-radius: 4px;
    padding: 0.5rem 0.9rem;
    text-decoration: none;
    transition: background-color 0.2s ease-out;
  }
  .equipment-card__cta:hover {
    background-color: var(--garnet-hover);
  }
  .equipment-picks__disclosure {
    font-family: var(--sans);
    font-size: 0.72rem;
    line-height: 1.5;
    color: rgba(45, 45, 44, 0.55);
    margin: 0.9rem 0 0;
  }
</style>
